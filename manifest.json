{
  "manifest_version": 3,
  "name": "How Many Tabs?",
  "version": "1.0.0",
  "description": "Counts how many times you've opened a new tab today.",
  "permissions": ["storage"],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
